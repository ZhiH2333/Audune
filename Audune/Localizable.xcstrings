{
  "sourceLanguage": "en",
  "strings": {
    " A custom color on this mode is replaced when the preset is applied.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 应用预设时，此模式下的自定义颜色会被替换。"
          }
        }
      }
    },
    " Copy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 副本"
          }
        }
      }
    },
    " Copy %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 副本 %lld"
          }
        }
      }
    },
    "%@ will be removed. The current %@ settings stay as they are.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”将被移除。当前的%2$@设置保持不变。"
          }
        }
      }
    },
    "%@ · Built-in": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 内置"
          }
        }
      }
    },
    "%@ · Custom": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 自定义"
          }
        }
      }
    },
    "%@ · Modified": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 已修改"
          }
        }
      }
    },
    "%lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "A new preset id could not be created.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建新的预设标识。"
          }
        }
      }
    },
    "About Audune": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 Audune"
          }
        }
      }
    },
    "Active on %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在%@上运行"
          }
        }
      }
    },
    "Active on %@ (fallback notched display)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在%@上运行（备用刘海显示器）"
          }
        }
      }
    },
    "Allow dragging by the grip": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许通过拖动手柄移动"
          }
        }
      }
    },
    "Allow resizing from the edges": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许从边缘调整大小"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许"
          }
        }
      }
    },
    "Amber": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "琥珀"
          }
        }
      }
    },
    "Amplitude": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "幅度"
          }
        }
      }
    },
    "Angular gap (deg)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "角度间隙（度）"
          }
        }
      }
    },
    "Animation speed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动画速度"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "Apple Event %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 事件错误 %lld"
          }
        }
      }
    },
    "Applies %@ settings only. Appearance, Window, and the other visual modes stay as they are.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅应用%@设置。外观、窗口和其他可视化模式保持不变。"
          }
        }
      }
    },
    "As Window": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作为窗口"
          }
        }
      }
    },
    "As Window behaves like an ordinary window and can be covered by others.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“作为窗口”与普通窗口一样，可被其他窗口遮挡。"
          }
        }
      }
    },
    "As Window stays on its own desktop and full-screen apps can cover it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“作为窗口”只停留在自己的桌面上，全屏 App 可以将其遮挡。"
          }
        }
      }
    },
    "Aspect ratio": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宽高比"
          }
        }
      }
    },
    "Attack (ms)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起音（ms）"
          }
        }
      }
    },
    "Audio below the noise floor counts as silence. Bars then settle to the baseline instead of switching off. This only affects the visualization, not system audio.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于噪声下限的音频视为静音。此时条形会平稳回落到基线，而不是突然消失。这只影响可视化，不影响系统音频。"
          }
        }
      }
    },
    "Audio capture failed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频捕获失败。"
          }
        }
      }
    },
    "Audio output device not ready.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频输出设备尚未就绪。"
          }
        }
      }
    },
    "Audune Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Audune 设置"
          }
        }
      }
    },
    "Audune can only control Music or Spotify, and only after you allow it. It cannot pause browser audio or other system output. Open the player first, then choose Request Access.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Audune 只能控制“音乐”或 Spotify，且需要你先允许。它无法暂停浏览器音频或其他系统输出。请先打开播放器，然后选择“请求授权”。"
          }
        }
      }
    },
    "Audune could not start system audio capture. Allow Audune in System Settings > Privacy & Security > Screen & System Audio Recording, then press Start again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Audune 无法开始捕获系统音频。请在“系统设置 > 隐私与安全性 > 屏幕与系统音频录制”中允许 Audune，然后再次点按“开始”。"
          }
        }
      }
    },
    "Audune has not been allowed to control this player yet. Use Request Access in Settings > Playback.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未允许 Audune 控制此播放器。请在“设置 > 播放”中选择“请求授权”。"
          }
        }
      }
    },
    "Audune, %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Audune，%@"
          }
        }
      }
    },
    "Automatic (Notched Display)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动（带刘海的显示器）"
          }
        }
      }
    },
    "Automatically hide controls": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动隐藏控件"
          }
        }
      }
    },
    "Automation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动化"
          }
        }
      }
    },
    "Automation was denied. Allow Audune in System Settings > Privacy & Security > Automation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动化”权限已被拒绝。请在“系统设置 > 隐私与安全性 > 自动化”中允许 Audune。"
          }
        }
      }
    },
    "Bands": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "频段"
          }
        }
      }
    },
    "Bar stroke": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条形描边"
          }
        }
      }
    },
    "Bars": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条形"
          }
        }
      }
    },
    "Built-in": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置"
          }
        }
      }
    },
    "Built-in presets cannot be changed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置预设无法更改。"
          }
        }
      }
    },
    "Built-in presets keep their names.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置预设保留原有名称。"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Capture failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "捕获失败"
          }
        }
      }
    },
    "Changes show in Studio immediately.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改会立即显示在 Studio 中。"
          }
        }
      }
    },
    "Checking": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查中"
          }
        }
      }
    },
    "Checking Automation access…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查“自动化”权限…"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查中…"
          }
        }
      }
    },
    "Choose Music or Spotify to enable Play/Pause in Studio.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“音乐”或 Spotify，即可在 Studio 中使用播放/暂停。"
          }
        }
      }
    },
    "Choose a player": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择播放器"
          }
        }
      }
    },
    "Clean": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "简洁"
          }
        }
      }
    },
    "Clicks on the visualization reach the app underneath in On Top, On Desktop, and As Window. The drag handle stays visible. The other buttons appear when the pointer is near and hide after 3 seconds without it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“置顶”“在桌面”和“作为窗口”模式下，点击可视化区域的操作会传递给下方的 App。拖动手柄始终可见。其他按钮在指针靠近时出现，指针离开 3 秒后隐藏。"
          }
        }
      }
    },
    "Collapse Notch Island": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起 Notch Island"
          }
        }
      }
    },
    "Collapse Now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即收起"
          }
        }
      }
    },
    "Collapse delay (s)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起延迟（秒）"
          }
        }
      }
    },
    "Color": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色"
          }
        }
      }
    },
    "Color mapping": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色映射"
          }
        }
      }
    },
    "Colors": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色"
          }
        }
      }
    },
    "Compact": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紧凑"
          }
        }
      }
    },
    "Compact bars per side": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紧凑模式每侧条形数"
          }
        }
      }
    },
    "Compact mode draws a symmetric live spectrum on both sides of the notch. Colors follow Appearance.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "紧凑模式会在刘海两侧绘制对称的实时频谱。颜色跟随“外观”。"
          }
        }
      }
    },
    "Control": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制"
          }
        }
      }
    },
    "Controls": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控件"
          }
        }
      }
    },
    "Corner radius": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆角半径"
          }
        }
      }
    },
    "Custom": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义"
          }
        }
      }
    },
    "Custom color": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义颜色"
          }
        }
      }
    },
    "Custom line color": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义线条颜色"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "Delete this preset?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此预设？"
          }
        }
      }
    },
    "Denied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝"
          }
        }
      }
    },
    "Dense": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密集"
          }
        }
      }
    },
    "Dense Ring": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密集环"
          }
        }
      }
    },
    "Density": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密度"
          }
        }
      }
    },
    "Disabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停用"
          }
        }
      }
    },
    "Disabled on %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在%@上停用"
          }
        }
      }
    },
    "Display": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器"
          }
        }
      }
    },
    "Display & Status": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器与状态"
          }
        }
      }
    },
    "Drag Studio": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动 Studio"
          }
        }
      }
    },
    "Draws the real captured audio signal. Density sets how many points are drawn.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘制真实捕获到的音频信号。密度决定绘制多少个点。"
          }
        }
      }
    },
    "Dual Band": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双频段"
          }
        }
      }
    },
    "Dual Band maps the lower half of the bands to an inner ring and the upper half to an outer ring.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“双频段”会把较低的一半频段映射到内圈，较高的一半映射到外圈。"
          }
        }
      }
    },
    "Duplicate": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制"
          }
        }
      }
    },
    "Dynamic": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动感"
          }
        }
      }
    },
    "Each bar reads its own real band.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每根条形读取各自的真实频段。"
          }
        }
      }
    },
    "Each bar shows the strength of one real frequency range from the captured audio.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每根条形显示捕获音频中一段真实频率范围的强度。"
          }
        }
      }
    },
    "Enable Notch Island": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用 Notch Island"
          }
        }
      }
    },
    "Enter a name.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入名称。"
          }
        }
      }
    },
    "Expand Now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即展开"
          }
        }
      }
    },
    "Expand delay (s)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开延迟（秒）"
          }
        }
      }
    },
    "Expand on pointer hover": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针悬停时展开"
          }
        }
      }
    },
    "Expanded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已展开"
          }
        }
      }
    },
    "Expanded mode": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开模式"
          }
        }
      }
    },
    "Fade controls in and out": {
      "localizations": {
