      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（已修改）"
          }
        }
      }
    },
    "%@ will be removed. The current %@ settings stay as they are.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”将被移除。当前的%2$@设置保持不变。"
          }
        }
      }
    },
    "%lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "A new preset id could not be created.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建新的预设标识。"
          }
        }
      }
    },
    "A selected preset is missing its visual settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选预设缺少视觉设置。"
          }
        }
      }
    },
    "A Visual preset updates that mode's saved look, like applying it in Settings. Appearance, Window, and Island chrome stay unchanged.": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视觉预设会更新该模式已保存的外观，效果与在设置中应用预设相同。外观、窗口和 Island 外观控件保持不变。"
          }
        }
      }
    },
    "About Audune": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 Audune"
          }
        }
      }
    },
    "Active on %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在%@上运行"
          }
        }
      }
    },
    "Active on %@ (fallback notched display)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在%@上运行（备用刘海显示器）"
