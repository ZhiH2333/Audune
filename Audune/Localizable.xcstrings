    "Audune sends the song title, artist, album, and duration to LRCLIB to find lyrics. Imported lyrics always take priority, and online results are never saved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Audune 会将歌曲标题、艺人、专辑和时长发送至 LRCLIB 以查找歌词。已导入的歌词始终优先，在线结果不会被保存。"
          }
        }
      }
    },
